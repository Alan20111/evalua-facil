# Copia este archivo a ".env" y rellena los valores (o cárgalos en Vercel → Settings → Environment Variables).
# Son claves PÚBLICAS del cliente web (Firebase las protege con reglas de Firestore + dominios autorizados).

# Firebase (Console → Project settings → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (PWA) — "Web Push certificate" (clave VAPID pública) que se genera en
# Firebase Console → Project settings → Cloud Messaging → Web configuration →
# "Generate key pair". Sin esto, el web push del PWA no se registra.
VITE_FIREBASE_VAPID_KEY=

# Cloudinary (subida de archivos de alumnos, preset unsigned)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Solo en el servidor (Vercel → Environment Variables) ──────────────────
# NO llevan el prefijo VITE_ a propósito: son secretos y no deben acabar en el
# bundle que descarga el navegador. En el .env local no hacen falta.

# Cloudinary (Console → Settings → API Keys). Subir archivos no necesita
# secreto, pero BORRARLOS sí: sin estas dos, al eliminar una cuenta se borran
# sus datos pero sus archivos se quedan ocupando espacio en Cloudinary
# (api/account/delete.js los deja anotados en el log de Vercel).
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
