# Copy this file to ".env" (inside Avatar/) and fill in your key.
# Never commit the real .env — it's covered by the root .gitignore (.env / .env.*).

# OpenAI API key with access to gpt-image-1 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Model used for image generation
OPENAI_IMAGE_MODEL=gpt-image-1

# Output image size (must be one of the sizes gpt-image-1 supports).
# Portrait (1024x1536) matches the reference character's full-body vertical
# framing and avoids head/feet cropping that a square canvas caused.
OPENAI_IMAGE_SIZE=1024x1536

# Optional overrides — defaults resolve relative to the Avatar/ folder
# OPENAI_REFERENCE_IMAGE=Avatar/Master Character v1.0.png
# OPENAI_OUTPUT_DIR=Avatar/Output
