# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env (set these in Vercel project settings instead)
.env
.env.*
!.env.example

# Vercel
.vercel

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code session/agent files (excepto launch.json, ver al final)
.claude/*

# Firebase emulator artifacts
firebase-debug.log
firestore-debug.log
ui-debug.log

# voice-pipeline.js output
/output/

# Avatar pose generation output (keep the folder, ignore generated images)
Avatar/Output/*
!Avatar/Output/.gitkeep

# Tokens temporales de pruebas locales — nunca deben commitearse ni servirse
public/zz-*.txt

# Credenciales de Firebase Admin SDK (service account) — nunca deben commitearse
seeds-db/*.json
!seeds-db/package.json
!seeds-db/package-lock.json

# Excepción: launch.json sí se versiona (config de dev-server para revisiones locales)
!.claude/launch.json

# Copia generada por scripts/sync-functions-shared.mjs — fuente real en
# src/utils/. Nunca se edita a mano ni se commitea.
functions/_shared/
