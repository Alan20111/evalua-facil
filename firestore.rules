rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANT: guard with exists() before get(). Students have NO users/{uid} doc, so a
    // bare get(users/{uid}).data.role throws during rule evaluation → the whole request is
    // denied with "Missing or insufficient permissions". exists() makes these return false
    // gracefully for any account without a users doc instead of erroring.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isDocente() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'docente';
    }

    // ── Candado de suscripción ──────────────────────────────────────────────
    // Un docente sin suscripción vigente puede LEER y exportar todo lo suyo,
    // pero no escribir. Hasta ahora ese candado vivía solo en el navegador
    // (src/utils/firestoreGuard.js): bastaban las herramientas de desarrollador
    // para seguir trabajando sin pagar. Aquí lo decide el servidor.
    //
    // `users/{uid}.suscripcionHasta` es un Timestamp que espeja la Cloud
    // Function onSuscripcionEscrita cada vez que cambia la suscripción. Se
    // compara contra request.time, así que el vencimiento ocurre solo con el
    // paso del tiempo: nada tiene que correr ese día.
    //
    // Campo AUSENTE = se deja pasar. Es una cuenta que todavía no pasó por el
    // respaldo inicial (seeds-db/backfill-suscripcion.js), y un dato faltante
    // nunca debe dejar a un docente fuera de su propio trabajo — mismo criterio
    // que isSubscriptionExpired en el cliente.
    function suscripcionHasta() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suscripcionHasta', null);
    }

    // Docente que además puede TRABAJAR: crear, editar, calificar, pasar lista,
    // publicar. Leer y exportar nunca pasan por aquí.
    function docenteActivo() {
      return isDocente() && (suscripcionHasta() == null || request.time < suscripcionHasta());
    }

    // ── Ownership helpers (cross-document) ──────────────────────────────────
    // Students have NO docenteId of their own; ownership is indirect via the
    // subject the enrollment belongs to. Guard every get() with exists() so a
    // dangling reference denies gracefully instead of erroring the whole request.

    // True when the signed-in user owns the subject `asigId` (is its docente).
    function ownsSubject(asigId) {
      return exists(/databases/$(database)/documents/subjects/$(asigId)) &&
        get(/databases/$(database)/documents/subjects/$(asigId)).data.docenteId == request.auth.uid;
    }

    // True when the signed-in user owns the activity `actId` (is its docente).
    function ownsActivity(actId) {
      return exists(/databases/$(database)/documents/activities/$(actId)) &&
        get(/databases/$(database)/documents/activities/$(actId)).data.docenteId == request.auth.uid;
    }

    // True when the signed-in student owns the enrollment doc `studentId`
    // (their auth uid is stamped on it — set during activation).
    function ownsStudentDoc(studentId) {
      return exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.uid == request.auth.uid;
    }

    // True when the enrollment doc `studentId` belongs to the SAME subject as the
    // activity `actId`. Without this, a student could create a submission on any
    // activity in the platform by pairing it with their own enrollment doc —
    // ownsStudentDoc alone only proves the enrollment is theirs, not that it
    // matches the activity's subject.
    function enrollmentMatchesActivity(studentId, actId) {
      return exists(/databases/$(database)/documents/activities/$(actId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.asignaturaId ==
          get(/databases/$(database)/documents/activities/$(actId)).data.asignaturaId;
    }

    // La calificación de una evaluación la escribe SOLO el servidor (Cloud
    // Function onEvaluacionFinalizada, vía Admin SDK — no pasa por estas
    // reglas) o el docente. Un alumno nunca toca los campos de nota en sus
    // propias escrituras: ni en updates (diff) ni marcándose 'calificado'.
    function studentNoTocaCalificacion() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['calificacion', 'intentos', 'pendienteRevision']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado']) ||
          request.resource.data.estado != 'calificado'
        );
    }

    match /schools/{schoolId} {
      allow read: if request.auth != null;
      // Schools are created/edited only from teacher flows (Register/Onboarding
      // run AFTER the users/{uid} doc exists, Profile is teacher-only), so
      // student accounts never need write access here.
      allow create: if isAdmin() || isDocente();
      allow update: if isAdmin() || isDocente();
    }

    match /users/{userId} {
      allow read: if true;
      // El perfil se crea UNA sola vez y lo escribe su propio dueño, así que es
      // la única escritura donde nadie estaba mirando: el `update` de abajo
      // congela `suscripcionHasta`, pero al crear se podía traer puesto. Un
      // docente recién registrado escribía su perfil con el candado abierto a
      // diez años y trabajaba sin vencimiento posible.
      //
      // Que la Cloud Function del espejo lo corrija al crear la prueba no es
      // una defensa, es una carrera: si tarda o falla, el valor inventado se
      // queda. Aquí el campo simplemente no puede venir — el cliente nunca lo
      // manda (ver createTeacherAccount), solo lo escribe el Admin SDK, que no
      // pasa por estas reglas.
      allow create: if request.auth.uid == userId &&
        request.resource.data.role == 'docente' &&
        !request.resource.data.keys().hasAny(['suscripcionHasta']);
      // `suscripcionHasta` (el candado de escritura, ver docenteActivo) queda
      // congelado en las ediciones del propio docente: solo lo escribe la Cloud
      // Function con el Admin SDK, que no pasa por estas reglas. Sin esto, el
      // candado se abriría desde la consola del navegador con un updateDoc al
      // propio perfil.
      allow update: if isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.get('suscripcionHasta', null) == resource.data.get('suscripcionHasta', null));
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      // Public read stays: the QR/code activation flow looks up students before
      // the account exists.
      allow read: if true;

      // Only the owning teacher (docente of the target subject) creates/deletes
      // enrollments. Students never create or delete their own record.
      allow create: if docenteActivo() && ownsSubject(request.resource.data.asignaturaId);
      allow delete: if docenteActivo() && ownsSubject(resource.data.asignaturaId);

      // Two legitimate updaters:
      //  (a) the owning teacher — may edit any field of their students.
      //  (b) the student themselves, during activation — claims an un-owned
      //      record by stamping their uid, and may only touch their own record
      //      afterwards. Identity fields (username/escuela/subject) are frozen
      //      so a student can't move or rename an enrollment, and can't hijack a
      //      record already claimed by a different uid.
      allow update: if
        (docenteActivo() && ownsSubject(resource.data.asignaturaId)) ||
        (
          request.auth != null &&
          request.resource.data.uid == request.auth.uid &&
          (resource.data.uid == null || resource.data.uid == request.auth.uid) &&
          request.resource.data.username == resource.data.username &&
          request.resource.data.escuelaId == resource.data.escuelaId &&
          request.resource.data.asignaturaId == resource.data.asignaturaId
        );
    }

    match /subjects/{subjectId} {
      allow read: if true;
      // Only teachers create subjects, always attributed to themselves.
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
    }

    match /activities/{activityId} {
      allow read: if request.auth != null;
      // Create only within a subject you own, attributed to yourself.
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;

      // Evaluación questions — only the owning teacher (looked up on the
      // parent activity) may write; any authenticated user may read. The
      // student-facing UI is responsible for not requesting `respuestaCorrecta`
      // while an attempt is in progress (rules can't filter fields).
      match /preguntas/{preguntaId} {
        allow read: if request.auth != null;
        allow write: if docenteActivo() &&
          request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.docenteId;
      }
    }

    // Asistencia — un documento por "hora" de clase (fecha + slot), con un mapa
    // presentes: { alumnoId: bool }. Mismo patrón de propiedad que activities.
    match /attendance/{attendanceId} {
      // Solo docentes/admin: ninguna vista de alumno lee asistencia directamente
      // (cada columna es compartida por TODO el grupo, con motivos de
      // justificación en texto libre) — sin esta restricción cualquier alumno
      // podía listar los pases de lista de toda la plataforma. El alumno ve su
      // propio resumen vía attendanceSummaries (ver más abajo).
      allow read: if isDocente() || isAdmin();
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Resumen de asistencia POR ALUMNO — lo escribe solo la Cloud Function
    // onAttendanceEscrita (Admin SDK, no pasa por estas reglas), recalculado
    // desde `attendance` cada vez que cambia una columna del grupo. El id del
    // documento ES el mismo id que su enrollment en `students`, así
    // ownsStudentDoc ya resuelve la propiedad sin ayuda adicional. Ningún
    // cliente escribe aquí — de ahí que no haya create/update/delete.
    match /attendanceSummaries/{studentId} {
      allow read: if request.auth != null && ownsStudentDoc(studentId);
    }

    // Personal question bank (Evaluaciones) — strictly owner-only.
    match /bancoReactivos/{reactivoId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Personal rubric bank (Entregables) — strictly owner-only. Students never
    // read this collection: the activity stores its own COPY of the rubric.
    match /bancoRubricas/{rubricaId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Permanent course materials (syllabus, guides, etc.) — not tied to an
    // activity, so they never generate a submission or grade. Same
    // read/write shape as activities: any authenticated user (teacher or
    // enrolled student) can read; only the owning teacher can write/delete.
    match /resources/{resourceId} {
      allow read: if request.auth != null;
      // Only teachers create resources, always attributed to themselves.
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Avisos — comunicados de solo-informar del docente a todo el grupo de
    // una asignatura (no es un chat: sin respuestas ni reacciones, así que
    // no hay una sub-colección de mensajes que proteger). Mismo patrón de
    // lectura/escritura que `activities`: cualquier autenticado lee, solo el
    // docente dueño de la asignatura crea/edita/borra los suyos.
    match /avisos/{avisoId} {
      allow read: if request.auth != null;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Confirmación de lectura de un aviso — un doc por (aviso, estudiante),
    // creado únicamente cuando el estudiante toca "Entendido" en la pantalla
    // obligatoria (ver AvisoLecturaModal.jsx). `estudianteId` es el ID del
    // DOC DE INSCRIPCIÓN (mismo patrón que `submissions.alumnoId`), no el
    // auth uid — se resuelve la propiedad con ownsStudentDoc(). Inmutable:
    // ni el estudiante ni el docente pueden editarla o borrarla después,
    // es un registro de auditoría de que sí se mostró y confirmó el aviso.
    match /avisoLecturas/{lecturaId} {
      allow read: if isAdmin() || isDocente() ||
        (request.auth != null && ownsStudentDoc(resource.data.estudianteId));
      allow create: if request.auth != null &&
        ownsStudentDoc(request.resource.data.estudianteId);
      allow update, delete: if false;
    }

    // Guardado personal de un aviso — el "marcador" del alumno, un doc por
    // (aviso, estudiante). A diferencia de `avisos.guardado` (del docente,
    // vive en el propio aviso porque hay un solo dueño), aquí cada alumno
    // necesita su propio estado: uno lo guarda, otro no, sobre el MISMO
    // aviso. Sí se puede borrar (a diferencia de avisoLecturas) — guardar es
    // una preferencia editable, no un registro de auditoría.
    match /avisoGuardados/{guardadoId} {
      allow read, delete: if request.auth != null && ownsStudentDoc(resource.data.estudianteId);
      allow create: if request.auth != null && ownsStudentDoc(request.resource.data.estudianteId);
      allow update: if false;
    }

    // "Eliminar" un aviso del lado del alumno — mismo patrón que
    // avisoGuardados (un doc por aviso, estudiante), pero para ocultarlo en
    // vez de guardarlo: el alumno no puede borrar el aviso real (es del
    // docente, y lo comparten sus compañeros), así que esto solo marca que
    // ya no debe aparecer en SU lista.
    match /avisoOcultos/{ocultoId} {
      allow read, delete: if request.auth != null && ownsStudentDoc(resource.data.estudianteId);
      allow create: if request.auth != null && ownsStudentDoc(request.resource.data.estudianteId);
      allow update: if false;
    }

    // Plantillas de avisos — el banco personal de mensajes rápidos de cada
    // docente (arranca con una copia editable de los 12 predefinidos, ver
    // PLANTILLAS_SEED en src/utils/avisos.js), para elegir de un toque al
    // publicar un aviso. Nadie más las necesita leer: no son parte del aviso
    // ya publicado (ese guarda su propio emoji/título, ver avisoEmoji()),
    // así que a diferencia de `avisos` esto NO es de lectura pública.
    match /avisoPlantillas/{plantillaId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // "Material de apoyo" — per-parcial course material (one or more files +
    // optional rich-text description). Independent of `activities`: it never
    // creates a submission/grade, so it has no link to `submissions` at all.
    // Same read/write shape as resources/activities.
    match /materials/{materialId} {
      allow read: if request.auth != null;
      // Only teachers create materials, always attributed to themselves.
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
    }

    match /submissions/{submissionId} {
      // Un alumno solo lee SUS entregas (calificaciones incluidas) — antes
      // cualquier cuenta autenticada podía listar las de toda la plataforma.
      // Los docentes/admin conservan lectura amplia: sus consultas (por
      // actividad, exports, tablas) no siempre pueden probar propiedad
      // por-documento y el dato sensible protegido aquí es el del alumno.
      // OJO clientes: las consultas de alumno deben filtrar alumnoId con `==`
      // (no `in`) para que ownsStudentDoc sea demostrable dentro del límite
      // de get()s por consulta.
      allow read: if isAdmin() || isDocente() ||
        (request.auth != null && ownsStudentDoc(resource.data.alumnoId));

      // A submission is written either by the student who owns it (submit /
      // resubmit / evaluación autosave) or by the teacher who owns the activity
      // (grading, marking complete). `alumnoId` is the STUDENT ENROLLMENT DOC ID
      // (not the auth uid), so ownership resolves through ownsStudentDoc().
      // El alumno NO escribe su nota: al crear, calificacion debe ser null y
      // estado no puede ser 'calificado'; al actualizar aplica
      // studentNoTocaCalificacion(). La nota real la pone la Cloud Function
      // onEvaluacionFinalizada (Admin SDK) o el docente (ownsActivity).
      allow create: if request.auth != null && (
        (
          ownsStudentDoc(request.resource.data.alumnoId) &&
          enrollmentMatchesActivity(request.resource.data.alumnoId, request.resource.data.actividadId) &&
          request.resource.data.get('calificacion', null) == null &&
          request.resource.data.get('estado', '') != 'calificado'
        ) ||
        (docenteActivo() && ownsActivity(request.resource.data.actividadId))
      );
      allow update: if request.auth != null && (
        (ownsStudentDoc(resource.data.alumnoId) && studentNoTocaCalificacion()) ||
        (docenteActivo() && ownsActivity(resource.data.actividadId))
      );
      // Borrar una submission borra su nota — eso es manipulación de
      // calificaciones si lo hace el alumno (ningún flujo del alumno borra
      // submissions). Solo el docente dueño de la actividad.
      allow delete: if docenteActivo() &&
        ownsActivity(resource.data.actividadId);

      // Evaluación answers (autosave + teacher revision). Only the student who
      // owns the parent submission, or the teacher who owns the parent activity,
      // may READ or WRITE — closes the cross-student hole where any
      // authenticated account could see or edit anyone's answers. Reads are
      // always scoped to a concrete submissionId (single doc or subcollection
      // query under it), so the parent get() resolves for list queries too.
      // El alumno solo autoguarda su respuesta — puntosObtenidos lo escriben
      // únicamente el servidor (Admin SDK) y el docente: sin este candado, un
      // cliente modificado podía asignarse los puntos de las preguntas de
      // revisión manual antes de que el docente las revisara.
      match /respuestas/{preguntaId} {
        allow read: if request.auth != null && (
          (
            exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
            ownsStudentDoc(get(/databases/$(database)/documents/submissions/$(submissionId)).data.alumnoId)
          ) || (
            exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
            ownsActivity(get(/databases/$(database)/documents/submissions/$(submissionId)).data.actividadId)
          )
        );
        allow write: if request.auth != null && (
          (
            docenteActivo() &&
            exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
            ownsActivity(get(/databases/$(database)/documents/submissions/$(submissionId)).data.actividadId)
          ) || (
            exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
            ownsStudentDoc(get(/databases/$(database)/documents/submissions/$(submissionId)).data.alumnoId) &&
            (
              resource == null
                ? !request.resource.data.keys().hasAny(['puntosObtenidos'])
                : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['puntosObtenidos'])
            )
          )
        );
      }
    }

    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if request.auth != null && (
        isAdmin() || resource.data.docenteId == request.auth.uid
      );
      // NADIE crea suscripciones desde el cliente, solo el administrador.
      //
      // Antes el docente podía crear la suya "en prueba o pendiente de pago", y
      // por ahí se colaban DOS ataques con una línea desde la consola del
      // navegador:
      //   · Crear una con `planId` y una `fechaVencimiento` a diez años: la
      //     Cloud Function que espeja la vigencia la tomaba por buena y le
      //     abría el candado de escritura (y le quitaba la marca de agua).
      //   · Crear una prueba nueva cada vez que la anterior venciera —
      //     `updatedAt` más reciente gana— para siempre.
      // La prueba inicial ahora la crea el servidor (onDocenteCreado en
      // functions/index.js), con sus propias fechas, que nadie puede inventar.
      allow create: if isAdmin();

      // El docente solo puede DECLARAR que va a pagar. `hasOnly` congela todo
      // lo demás: sin esto podía reescribir fechas y plan en el mismo update
      // que cambiaba el status, que era el agujero de verdad — el status por sí
      // solo no otorga nada, las fechas sí.
      allow update: if isAdmin() || (
        isDocente() &&
        resource.data.docenteId == request.auth.uid &&
        request.resource.data.status == 'pendiente_pago' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'escuelaId', 'schoolName'])
      );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null && (
        isAdmin() || resource.data.docenteId == request.auth.uid
      );
      // Un docente DECLARA una transferencia; el administrador la coteja con el
      // estado de cuenta y la aprueba. Aprobar es lo único que activa la
      // suscripción, y eso ya era exclusivo del admin (`update`).
      //
      // Lo que faltaba candar es CUÁNTO se activa. Al aprobar, el panel lee del
      // propio pago la periodicidad del plan y los meses (ver handleApprove en
      // PaymentsTable.jsx), así que un pago fabricado desde la consola con
      //   { planId: 'anual', mesesPagados: 6 }
      // convertía una transferencia de un mes en SEIS AÑOS de suscripción, sin
      // que el diálogo de confirmación dijera nada de años. Por eso el plan y
      // los meses se fijan aquí:
      //   · planId 'pro' — el único plan que se vende hoy (MONTHLY_PLAN_ID en
      //     subscriptionHelpers.js), y el único mensual. Si algún día vuelve el
      //     anual, se agrega aquí a propósito.
      //   · mesesPagados 1..6 — el tope real del selector (MESES_DESCUENTO).
      //   · subscriptionId tiene que ser SUYA: sin esto, un docente podía pagar
      //     y acreditarle el mes a la cuenta de otro.
      //   · createdAt == request.time — el folio de transacción del panel se
      //     numera por antigüedad; con una fecha inventada un pago nuevo podía
      //     colarse como si fuera viejo.
      //   · hasOnly cierra el resto: `archivado` (un pago nacía escondido de la
      //     lista del admin), `comentarios`, `notasAdmin` (notas del admin que
      //     el docente no escribe) y `notificadoAdmin` (el candado de
      //     idempotencia del aviso — ponerlo en true silenciaba el push).
      // El MONTO no se valida aquí a propósito: la tarifa cambia (hoy es precio
      // de lanzamiento) y una regla desfasada dejaría a todos sin poder pagar.
      // Se acota a un rango sano y el panel avisa cuando no coincide con la
      // tarifa oficial — el admin ya coteja ese monto contra el banco.
      // `hasAll`/`hasOnly` van PRIMERO: leer un campo que no existe no da
      // falso, revienta la evaluación entera de la regla. Con el juego de
      // llaves ya comprobado, todo lo de abajo se puede leer sin rodeos.
      allow create: if isAdmin() || (
        isDocente() &&
        request.resource.data.keys().hasAll([
          'docenteId', 'subscriptionId', 'planId', 'monto', 'metodo', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'docenteId', 'subscriptionId', 'planId', 'escuelaId', 'monto', 'mesesPagados',
          'metodo', 'referencia', 'status', 'createdAt', 'comprobanteUrl', 'reenvioDePagoId'
        ]) &&
        request.resource.data.docenteId == request.auth.uid &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.metodo == 'transferencia' &&
        request.resource.data.planId == 'pro' &&
        // `mesesPagados` se valida pero NO se exige: la app de Android lleva su
        // propio paquete y tarda en actualizarse, y un pago sin el campo vale
        // por un mes en todo el proyecto (`mesesPagados || 1` al aprobar). Sin
        // este default, la app instalada hoy se quedaría sin poder reenviar un
        // pago rechazado en cuanto se publiquen estas reglas.
        request.resource.data.get('mesesPagados', 1) is int &&
        request.resource.data.get('mesesPagados', 1) >= 1 &&
        request.resource.data.get('mesesPagados', 1) <= 6 &&
        request.resource.data.monto is number &&
        request.resource.data.monto > 0 &&
        request.resource.data.monto <= 5000 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.subscriptionId is string &&
        exists(/databases/$(database)/documents/subscriptions/$(request.resource.data.subscriptionId)) &&
        get(/databases/$(database)/documents/subscriptions/$(request.resource.data.subscriptionId)).data.docenteId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Public payment configuration (display data only: public keys, bank info).
    // Secrets (access tokens / client secrets) live in server env vars, never here.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Personal calendar events created by the teacher — 100% privados, nunca
    // visibles a alumnos.
    match /events/{eventId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Eventos ACADÉMICOS del docente (conferencias, suspensiones, entregas de
    // proyecto…) — compartidos con los alumnos de `asignaturaId`. Colección
    // SEPARADA de `events` a propósito: Firestore solo puede autorizar un
    // `list` cuando la regla se puede probar a partir de los propios filtros
    // de la consulta. El alumno consulta por `asignaturaId` (no conoce el
    // docenteId de antemano), así que una regla que dependiera de
    // `resource.data.docenteId`/`tipo` (como en `events`) rechaza la
    // consulta ENTERA aunque cada documento sí cumpliera la condición —
    // comprobado en vivo: `getDoc` de un documento así sí funciona, pero el
    // `list` por `asignaturaId` da "Missing or insufficient permissions".
    // Lectura amplia (mismo patrón que activities/avisos/materials): no es
    // información sensible, el alumno filtra del lado cliente sus materias.
    match /academicEvents/{eventId} {
      allow read: if request.auth != null;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Personal calendar events created by a STUDENT (their own Agenda) —
    // mismo patrón que `events` del docente, pero con alumnoId (uid de Auth).
    match /studentEvents/{eventId} {
      allow read, update, delete: if request.auth != null &&
        request.auth.uid == resource.data.alumnoId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.alumnoId;
    }

    // Teacher's class schedule blocks (Mi Horario — legacy recurring blocks).
    match /horario/{bloqueId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Programación de bloques de clases por asignatura (fechas reales generadas
    // a partir de un rango + patrones semanales; se pueden mover/editar/eliminar
    // individualmente). Lectura ampliada a cualquier autenticado — igual que
    // activities/avisos/materials — para que la Agenda del alumno pueda armar
    // "Ahora"/"Próxima clase" a partir del horario de sus propios docentes;
    // no es información sensible (materia, hora, aula), y el alumno filtra
    // del lado cliente solo lo de sus materias inscritas.
    match /horarioBloques/{bloqueId} {
      allow read: if request.auth != null;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Días de asueto del docente. Cada doc marca una fecha en la que no se
    // permiten (según su alcance) clases, eventos y/o actividades.
    match /asuetos/{asuetoId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Vacaciones del docente. Cada doc marca un PERIODO (fechaInicio–fechaFin)
    // en el que no se permiten (según su alcance) clases, eventos y/o
    // actividades — misma estructura que asuetos, pero para un rango de días.
    match /vacaciones/{vacacionId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if docenteActivo() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if docenteActivo() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Preferencias de notificación del estudiante — UNA por cuenta (el id del
    // doc ES su uid de Auth, global entre todas sus inscripciones). Solo el
    // propio estudiante la lee/escribe; Cloud Functions usa el Admin SDK y
    // no pasa por estas reglas.
    match /notificationSettings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Registro de notificaciones REALMENTE enviadas (docente o alumno) —
    // la Cloud Function las escribe vía Admin SDK (bypasa estas reglas); el
    // cliente lee, crea (recordatorios locales, ver más abajo) y borra solo
    // las suyas — la Bitácora de Notificaciones (docente) permite borrar
    // cada renglón. `uid` es el destinatario, NO el id del documento (ids
    // autogenerados: puede haber muchas por uid).
    match /notificationLog/{logId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      // El docente registra sus propios recordatorios locales (clase/evento)
      // entregados en su celular — los push del servidor los sigue
      // registrando la Cloud Function (Admin SDK, no pasa por esta regla).
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}
