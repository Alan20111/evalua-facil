rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANT: guard with exists() before get(). Students have NO users/{uid} doc, so a
    // bare get(users/{uid}).data.role throws during rule evaluation → the whole request is
    // denied with "Missing or insufficient permissions". exists() makes these return false
    // gracefully for any account without a users doc instead of erroring.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isDocente() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'docente';
    }

    // ── Tarifa oficial de un pago por transferencia (Bloque 7, 13-ago-2026;
    // reestructuración de precios 18-ago-2026) ──
    // Espejo de MESES_DESCUENTO/MAYOR_PRICE_MXN/BASICO_PRICE_MXN en
    // subscriptionHelpers.js — ahí vive la fuente comercial editable; aquí
    // solo se repite para que el servidor deje de confiar en el monto que
    // declara el cliente. `mayor` y `basico` solo tienen tarifa a 1 mes (sin
    // política de descuento por varios meses); cualquier otra combinación de
    // planId/meses no tiene tarifa oficial y `null` nunca es igual a un monto
    // numérico, así que la combinación se rechaza sola.
    function montoOficialPago(planId, meses) {
      return planId == 'pro' ? (
        meses == 1 ? 199 :
        meses == 2 ? 382 :
        meses == 3 ? 549 :
        meses == 4 ? 700 :
        meses == 5 ? 834 :
        meses == 6 ? 953 : null
      ) : planId == 'mayor' ? (
        meses == 1 ? 299 : null
      ) : planId == 'basico' ? (
        meses == 1 ? 99 : null
      ) : null;
    }

    // ── Tarifa oficial de un paquete de créditos (créditos puros, 20-ago-2026) ──
    // Espejo de config/iaTarifas.paquetesCreditos (seeds-db/seed-ia-tarifas.js)
    // — misma razón que montoOficialPago arriba: el servidor no confía en el
    // precio que declara el cliente. 6 paquetes definitivos.
    //
    // ⚠️ SI ESTE ESPEJO Y config/iaTarifas.paquetesCreditos DEJAN DE
    // COINCIDIR, TODAS LAS COMPRAS SE RECHAZAN con "Missing or insufficient
    // permissions" — y en silencio: el docente ve un error genérico, nadie
    // recibe una alerta, y el único ingreso del negocio queda caído sin que
    // se note. Ya pasó (26-ago-2026): se sembró la tabla v3 con los 6
    // paquetes nuevos y estas reglas se quedaron con los viejos
    // (100/175/350/700/1400/2800), así que los 6 paquetes que ofrecía
    // ComprarCreditosModal.jsx eran rechazados uno por uno.
    //
    // LAS REGLAS NO SE DESPLIEGAN SOLAS. Todo cambio en
    // seeds-db/seed-ia-tarifas.js → paquetesCreditos obliga a actualizar esta
    // función Y a correr `firebase deploy --only firestore:rules`.
    //
    // Valores tomados de config/iaTarifas.paquetesCreditos (leído en vivo el
    // 26-ago-2026), con descuento por volumen: el paquete de 50 es el único
    // sin descuento ($1.00/crédito); los otros cinco van a $0.90/crédito.
    function montoOficialCredito(creditos) {
      return creditos == 50 ? 50 :
        creditos == 100 ? 90 :
        creditos == 200 ? 180 :
        creditos == 400 ? 360 :
        creditos == 800 ? 720 :
        creditos == 1600 ? 1440 : null;
    }

    // ── Modelo de créditos puros ────────────────────────────────────────────
    // Se retiró el candado por tiempo de suscripción el 20-ago-2026
    // (`isDocente()`/`suscripcionHasta()` ya NO existen): todo lo que no es IA
    // queda abierto para cualquier docente autenticado.
    // `users/{uid}.suscripcionHasta` puede seguir existiendo como dato
    // histórico; simplemente ya no lo lee ninguna regla.
    //
    // 26-ago-2026 — se retira también `saldoIAPositivo`, que era lo último que
    // bloqueaba a alguien: exigía saldo > 0 para escribir Asistencia. La
    // plataforma es GRATUITA y el único ingreso son los créditos de IA
    // prepagados; pasar lista no consume créditos y por lo tanto no puede
    // exigirlos (decisión de Kike: "pasar lista NO debe requerir saldo, es
    // gratuita de verdad"). Era además el peor caso posible: la AUSENCIA del
    // doc `iaCreditos` contaba como saldo 0, así que una cuenta recién creada
    // no podía pasar lista hasta que `onDocenteCreado` le otorgara el regalo
    // de bienvenida.
    //
    // Lo mismo del lado del cliente: el banner y los modales de Asistencia
    // (SubjectPage.jsx) y el candado de descargas (src/utils/exportGuard.js,
    // cableado en Layout.jsx) se desactivaron en el mismo cambio.

    // ── Ownership helpers (cross-document) ──────────────────────────────────
    // Students have NO docenteId of their own; ownership is indirect via the
    // subject the enrollment belongs to. Guard every get() with exists() so a
    // dangling reference denies gracefully instead of erroring the whole request.

    // ── Escuela obligatoria (30-ago-2026) ────────────────────────────────
    // TODO DOCENTE PERTENECE A UNA ESCUELA. La pantalla ya lo exige, pero la
    // validación visual no es una defensa: sin esto, un `updateDoc` desde la
    // consola del navegador deja un perfil operativo sin plantel, y de ahí
    // salen asignaturas y alumnos que ningún compañero de escuela encuentra.
    //
    // 'sin-escuela' era un documento centinela COMPARTIDO por todos los
    // docentes que no elegían plantel — no es una escuela, así que aquí
    // cuenta como no tener ninguna.
    function escuelaReal(valor) {
      return valor is string && valor != '' && valor != 'sin-escuela';
    }

    // Un perfil de docente puede existir a medio llenar (se crea antes de
    // resolver la escuela, ver Register.jsx), pero NO puede quedar marcado
    // como completo —es decir, operativo— sin una escuela real.
    function perfilDocenteConEscuela(data) {
      return data.get('profileComplete', false) != true ||
        escuelaReal(data.get('escuelaId', ''));
    }

    // Para inscripciones y asignaturas basta con que el campo venga y no esté
    // vacío: la escuela sale del docente (que ya pasó por escuelaReal) o, al
    // reinscribir a alguien que ya existía, de sus inscripciones hermanas —
    // que pueden ser viejas y traer todavía el centinela. Exigirles
    // escuelaReal aquí rompería re-inscribir a un alumno de antes.
    function traeEscuela(data) {
      return data.get('escuelaId', '') is string && data.get('escuelaId', '') != '';
    }

    // True when the signed-in user owns the subject `asigId` (is its docente).
    function ownsSubject(asigId) {
      return exists(/databases/$(database)/documents/subjects/$(asigId)) &&
        get(/databases/$(database)/documents/subjects/$(asigId)).data.docenteId == request.auth.uid;
    }

    // True when the signed-in user owns the activity `actId` (is its docente).
    function ownsActivity(actId) {
      return exists(/databases/$(database)/documents/activities/$(actId)) &&
        get(/databases/$(database)/documents/activities/$(actId)).data.docenteId == request.auth.uid;
    }

    // True when the signed-in student owns the enrollment doc `studentId`
    // (their auth uid is stamped on it — set during activation).
    function ownsStudentDoc(studentId) {
      return exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.uid == request.auth.uid;
    }

    // True when the enrollment doc `studentId` belongs to the SAME subject as the
    // activity `actId`. Without this, a student could create a submission on any
    // activity in the platform by pairing it with their own enrollment doc —
    // ownsStudentDoc alone only proves the enrollment is theirs, not that it
    // matches the activity's subject.
    function enrollmentMatchesActivity(studentId, actId) {
      return exists(/databases/$(database)/documents/activities/$(actId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.asignaturaId ==
          get(/databases/$(database)/documents/activities/$(actId)).data.asignaturaId;
    }

    // ── A12 · H3 · El servidor, no el navegador, decide si el plazo cerró ──
    //
    // "Entregar después del cierre" pasaba sin más: el cliente calculaba
    // `isPastDeadline` con el reloj del teléfono (ActivityPage.jsx) y solo
    // ESCONDÍA el formulario — un `addDoc` directo, o simplemente atrasar el
    // reloj, creaba la entrega igual. Reproducido contra el emulador antes de
    // corregirse.
    //
    // `fechaLimite`/`extensiones` se guardan como STRING (para mostrarse tal
    // cual), así que la regla no las lee: compara contra `fechaLimiteTS` /
    // `extensionesTS`, el mismo instante ya resuelto a Timestamp por el
    // CLIENTE con un Date real (ver src/utils/deadline.js) — parsear el string
    // aquí, con los helpers de timestamp.date(), asumiría UTC y desfasaría el
    // corte varias horas contra la hora local de México. Ambos campos son
    // opcionales (actividad sin plazo, alumno sin prórroga) y su ausencia dice
    // "sin plazo", igual que el resto del archivo: un dato faltante nunca
    // cierra el trabajo de nadie.
    //
    // La prórroga de un alumno, si existe, REEMPLAZA la fecha límite del
    // grupo para él — mismo criterio que `displayDate` en el cliente, no se
    // suman ambos plazos.
    //
    // Actividades sembradas antes de este candado no tienen `fechaLimiteTS`
    // hasta que el docente edite la fecha o corra
    // seeds-db/backfill-fecha-limite-ts.js — hasta entonces, para ellas, el
    // candado no aplica (mismo criterio de "campo ausente" de arriba).
    function actividadVencidaParaAlumno(actId, alumnoId) {
      let act = exists(/databases/$(database)/documents/activities/$(actId))
        ? get(/databases/$(database)/documents/activities/$(actId)).data
        : null;
      let limite = act == null ? null : act.get('extensionesTS', {}).get(alumnoId, act.get('fechaLimiteTS', null));
      return act != null && (
        act.get('cerradaManual', false) == true ||
        (limite != null && request.time >= limite && act.get('recibirTarde', false) != true)
      );
    }

    // La calificación de una evaluación la escribe SOLO el servidor (Cloud
    // Function onEvaluacionFinalizada, vía Admin SDK — no pasa por estas
    // reglas) o el docente. Un alumno nunca toca los campos de nota en sus
    // propias escrituras: ni en updates (diff) ni marcándose 'calificado'.
    // A09 · `rubricaEval` entra a esta lista, y no es un detalle. Es la
    // evaluación por criterio con la que se calificó: el instrumento que
    // justifica el número ante la escuela, y lo escribía el propio calificado.
    // Reproducido contra el emulador: un alumno con un 4.7 reescribía su
    // rúbrica a "todo excelente" sin tocar la calificación.
    //
    // Y no se queda en la apariencia. El panel del docente se PRELLENA desde
    // este campo (ActivityPage.jsx:349), así que al reabrir una entrega ya
    // calificada el docente ve la rúbrica falsificada; si ajusta un solo
    // criterio, selectRubricaNivel recalcula el total sobre esa base y el
    // número falsificado se vuelve la calificación.
    //
    // Ningún flujo del alumno escribe aquí: su pantalla solo lo lee.
    function studentNoTocaCalificacion() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['calificacion', 'intentos', 'pendienteRevision', 'rubricaEval']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado']) ||
          request.resource.data.estado != 'calificado'
        );
    }

    // ── A09 · La calificación no puede salirse de su escala ─────────────────
    //
    // Todos los caminos del cliente topan contra `maxCalif` menos uno: el
    // cierre de parcial, que acota por abajo y no por arriba y escribe EN
    // BLOQUE a todo el que no entregó (SubjectPage.jsx). Un 50 en una escala
    // de 10 envenena el promedio del parcial, el final y lo exportado.
    // Comprobado contra el emulador: el servidor aceptaba 50 y también −5.
    //
    // Campo AUSENTE en la actividad = escala 10, que es lo que crean hoy los
    // tres editores. Y solo se revisa cuando la calificación CAMBIA: sin eso,
    // un documento viejo fuera de rango se volvería imposible de editar,
    // aunque solo se le tocara el comentario (§1.2). Comprobado en producción
    // el 7-ago-2026: 0 de 46 calificaciones están fuera de rango.
    function maxCalifDe(actId) {
      return exists(/databases/$(database)/documents/activities/$(actId))
        ? get(/databases/$(database)/documents/activities/$(actId)).data.get('maxCalif', 10)
        : 10;
    }

    function calificacionEnRango(actId) {
      return request.resource.data.get('calificacion', null) == null ||
        (
          request.resource.data.calificacion >= 0 &&
          request.resource.data.calificacion <= maxCalifDe(actId)
        );
    }

    function calificacionEnRangoSiCambia(actId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['calificacion']) ||
        calificacionEnRango(actId);
    }

    // ── A08 · El alumno no maneja la máquina de estados de su examen ────────
    //
    // Blindar `calificacion` no basta, y esto no era evidente: el alumno no
    // necesitaba escribir su nota para elegirla. Le bastaba con mover tres
    // campos que nadie vigilaba —`estadoEvaluacion`, `intentoActual` y
    // `tiempoInicio`— para hacer que el SERVIDOR se la recalculara cuantas
    // veces quisiera:
    //
    //   contestar → finalizar → leer la nota que puso el servidor →
    //   volver a "en_progreso" → cambiar las respuestas → subir el número de
    //   intento para esquivar el candado de idempotencia → finalizar otra vez
    //
    // Con `conservar: 'mejor'` eso es quedarse con el 10 a base de repetir, y
    // con 'ultimo' es contestar con el examen delante. Reproducido contra el
    // emulador antes de corregirse: los cuatro pasos pasaban.
    //
    // La clave del arreglo es que `intentos[]` SOLO lo escribe el servidor (ya
    // estaba blindado arriba), así que sirve de ancla honesta: el número de
    // intento en curso tiene que ser exactamente los ya calificados + 1. Eso
    // permite el reintento legítimo (ver handleStartOrContinueEvaluacion en
    // ActivityPage.jsx, que manda justamente `intentos.length + 1`) y hace
    // imposible inventarse un número.
    function evalConfig(actId) {
      return get(/databases/$(database)/documents/activities/$(actId)).data
        .get('evaluacion', {});
    }

    // Un intento nuevo: el número avanza al siguiente real y quedan intentos.
    // `intentosPermitidos` ausente o null = ilimitados (regla 1.2: un dato que
    // falta no deja a nadie fuera).
    function intentoNuevoValido() {
      return request.resource.data.get('intentoActual', 0) == resource.data.get('intentos', []).size() + 1 &&
        (
          evalConfig(resource.data.actividadId).get('intentosPermitidos', null) == null ||
          resource.data.get('intentos', []).size() < evalConfig(resource.data.actividadId).get('intentosPermitidos', 0)
        );
    }

    function studentNoManipulaIntento() {
      // Si no toca ninguno de los tres campos, no hay nada que revisar: es un
      // autoguardado normal (ordenSeed, notificadoEntregaDocente, etc.).
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['estadoEvaluacion', 'intentoActual', 'tiempoInicio']) ||
        (
          // Abrir un intento nuevo. Es la ÚNICA vía por la que el alumno puede
          // mover estos tres campos, y los mueve los tres a la vez.
          //
          // El número TIENE que avanzar. Sin esa condición, un documento que ya
          // estaba en curso cumplía esta rama sin cambiar nada, y por ahí se
          // colaba el reinicio del cronómetro a secas — que era justo uno de
          // los ataques. El primer intento no pasa por aquí: se crea con
          // addDoc, no con update.
          request.resource.data.get('estadoEvaluacion', '') == 'en_progreso' &&
          request.resource.data.get('intentoActual', 0) != resource.data.get('intentoActual', 0) &&
          intentoNuevoValido()
        ) ||
        (
          // Cerrar el intento en curso. Ni el número ni el reloj se tocan: el
          // reloj congelado es lo que sostiene el plazo de las respuestas.
          request.resource.data.get('estadoEvaluacion', '') == 'finalizado' &&
          resource.data.get('estadoEvaluacion', '') == 'en_progreso' &&
          request.resource.data.get('intentoActual', 0) == resource.data.get('intentoActual', 0) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tiempoInicio'])
        );
    }

    // El plazo se mide contra `request.time` —el reloj del SERVIDOR— y contra
    // `tiempoInicio`, que ya no se puede mover (arriba). Antes el único control
    // era `Date.now()` en el navegador (EvaluacionRunner.jsx): atrasar el reloj
    // del teléfono daba tiempo infinito, y contestar 15 minutos después de que
    // se acabara pasaba sin más. Reproducido antes de corregirse.
    //
    // El margen de un minuto es para no castigar a quien contesta en el último
    // segundo con la red lenta: a un tramposo no le sirve de nada.
    function dentroDelPlazo(submissionId) {
      let sub = get(/databases/$(database)/documents/submissions/$(submissionId)).data;
      let limite = evalConfig(sub.actividadId).get('tiempoLimiteMin', null);
      return limite == null || sub.get('tiempoInicio', null) == null ||
        request.time < sub.tiempoInicio + duration.value(limite, 'm') + duration.value(1, 'm');
    }

    match /schools/{schoolId} {
      allow read: if request.auth != null;
      // Schools are created/edited only from teacher flows (Register/Onboarding
      // run AFTER the users/{uid} doc exists, Profile is teacher-only), so
      // student accounts never need write access here.
      allow create: if isAdmin() || isDocente();
      // R1: cualquier docente podía renombrar la escuela de cualquier otro.
      //
      // No se puede exigir "solo la tuya" a secas: al registrarse, quien se une
      // a una escuela que ya existe le COMPLETA los datos que le faltaban —
      // clave, municipio, estado (ver resolveSchoolSelection en
      // utils/schoolSelection.js)— y eso pasa antes de que su propio perfil
      // tenga `escuelaId`. Ese camino nunca escribe el nombre.
      //
      // Así que se congela lo que da identidad: el nombre y el nombre corto
      // solo los cambia el administrador o quien pertenece a esa escuela. Todo
      // lo demás se puede seguir completando, que es lo que el alta necesita.
      allow update: if isAdmin() || (
        isDocente() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('escuelaId', '') == schoolId ||
          (
            request.resource.data.get('nombre', '') == resource.data.get('nombre', '') &&
            request.resource.data.get('shortName', '') == resource.data.get('shortName', '')
          )
        )
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      // El perfil se crea UNA sola vez y lo escribe su propio dueño, así que es
      // la única escritura donde nadie estaba mirando: el `update` de abajo
      // congela `suscripcionHasta`, pero al crear se podía traer puesto. Un
      // docente recién registrado escribía su perfil con el candado abierto a
      // diez años y trabajaba sin vencimiento posible.
      //
      // Que la Cloud Function del espejo lo corrija al crear la prueba no es
      // una defensa, es una carrera: si tarda o falla, el valor inventado se
      // queda. Aquí el campo simplemente no puede venir — el cliente nunca lo
      // manda (ver createTeacherAccount), solo lo escribe el Admin SDK, que no
      // pasa por estas reglas.
      allow create: if request.auth.uid == userId &&
        request.resource.data.role == 'docente' &&
        !request.resource.data.keys().hasAny(['suscripcionHasta']) &&
        perfilDocenteConEscuela(request.resource.data);
      // `suscripcionHasta` ya no gatea nada (modelo de créditos puros,
      // 20-ago-2026) pero se congela igual como dato histórico: solo lo
      // escribe la Cloud Function con el Admin SDK, que no pasa por estas
      // reglas. Sin esto, el campo se editaría desde la consola del
      // navegador con un updateDoc al propio perfil.
      allow update: if isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.get('suscripcionHasta', null) == resource.data.get('suscripcionHasta', null) &&
         perfilDocenteConEscuela(request.resource.data));
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      // Public read stays: the QR/code activation flow looks up students before
      // the account exists.
      allow read: if true;

      // Only the owning teacher (docente of the target subject) creates/deletes
      // enrollments. Students never create or delete their own record.
      // Ningún estudiante puede nacer sin escuela (ver traeEscuela arriba):
      // su cuenta ES `usuario.escuela@evalua.local`, así que una inscripción
      // sin escuela no puede ni activarse.
      allow create: if isDocente() && ownsSubject(request.resource.data.asignaturaId) &&
        traeEscuela(request.resource.data);
      allow delete: if isDocente() && ownsSubject(resource.data.asignaturaId);

      // Two legitimate updaters:
      //  (a) the owning teacher — may edit any field of their students.
      //  (b) the student themselves, during activation — claims an un-owned
      //      record by stamping their uid, and may only touch their own record
      //      afterwards. Identity fields (username/escuela/subject) are frozen
      //      so a student can't move or rename an enrollment, and can't hijack a
      //      record already claimed by a different uid.
      // El segundo camino pedía dos cosas —que nadie la hubiera reclamado antes
      // y que estamparas TU uid— pero no la que importaba: **que fueras esa
      // persona**. Con `students` de lectura pública, cualquiera con sesión
      // podía listar las inscripciones sin activar y quedarse con la de otro:
      // sus calificaciones, sus entregas, y entregar en su nombre.
      //
      // La prueba de identidad es el correo de Auth, que para un estudiante es
      // determinista: usuario.escuela@evalua.local (ver studentEmail en
      // src/utils/generate.js). Nadie puede iniciar sesión con el correo de
      // otro, así que reclamar la inscripción de otro deja de ser posible sin
      // cambiar nada del flujo real de activación.
      //
      // `get('uid', null)` en vez de `resource.data.uid`: un campo AUSENTE no
      // da falso, revienta la evaluación de la regla entera. Las inscripciones
      // dadas de alta por Excel no traen el campo, y así ninguna se quedaba sin
      // poder activarse.
      //
      // CORRECCIÓN 23-ago-2026 (regla definitiva de Kike): la incorporación
      // por código NO debe depender de la escuela — el código de asignatura
      // + estar en el roster que el docente ya armó es la ÚNICA llave. Antes
      // se exigía el CORREO COMPLETO (usuario.escuela@evalua.local), lo que
      // ataba la identidad a la escuela con la que el alumno se activó la
      // primera vez y bloqueaba el caso legítimo (docente de otra escuela lo
      // agrega, código correcto, pero su cuenta ya existe con OTRA escuela).
      // Ahora solo se exige que la parte de USUARIO del correo coincida — la
      // escuela del correo puede ser cualquiera. Sigue siendo imposible
      // reclamar el registro de otro alumno: nadie puede tener sesión con un
      // correo cuyo usuario no sea el suyo (Firebase Auth es la única fuente
      // de ese dato, nadie lo escribe). `escuelaId` DEL REGISTRO se sigue
      // congelando abajo (nadie puede reescribirlo) — solo dejó de ser parte
      // de la prueba de identidad del que reclama.
      allow update: if
        (isDocente() && ownsSubject(resource.data.asignaturaId)) ||
        (
          request.auth != null &&
          request.resource.data.uid == request.auth.uid &&
          (resource.data.get('uid', null) == null || resource.data.uid == request.auth.uid) &&
          request.auth.token.get('email', '').lower()
            .matches(resource.data.username.lower() + '\\..+@evalua\\.local') &&
          request.resource.data.username == resource.data.username &&
          request.resource.data.escuelaId == resource.data.escuelaId &&
          request.resource.data.asignaturaId == resource.data.asignaturaId &&
          // El padrón es del docente. El estudiante solo toca lo suyo: los
          // cuatro campos de su activación (ver finishActivation en
          // Activation.jsx) y su foto (ver updateAllEnrollments). Sin esto
          // podía reescribir su propio nombre en la lista del maestro —y con
          // él, el de las actas y exportaciones—, cambiar su `orden`, o
          // agregar campos que ninguna pantalla espera.
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['activado', 'uid', 'resetPassword', 'activadoAt', 'photoURL'])
        );
    }

    match /subjects/{subjectId} {
      allow read: if true;
      // Only teachers create subjects, always attributed to themselves — y
      // siempre con la escuela del docente puesta (ver traeEscuela arriba).
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId &&
        traeEscuela(request.resource.data);
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;

      // Diagnóstico del grupo — Asistente IA (FASE 2-BIS del Plan Maestro de
      // IA). Bitácora de generaciones, mismo patrón que activities/analisisIA:
      // append-only (cada "Generar diagnóstico" crea un documento nuevo, la
      // versión anterior nunca se pisa) e INMUTABLE en su contenido (sin
      // update). A diferencia de analisisIA (cualquier autenticado la lee),
      // esta es PRIVADA del docente dueño: es contexto pedagógico suyo, no
      // material del grupo.
      //
      // SÍ permite delete (12-ago-2026, pedido explícito de Kike): una
      // generación mal hecha de la IA (p. ej. del reporte simulado que
      // Tanda 2 reemplaza) el docente debe poder borrarla de inmediato — no
      // es lo mismo que "editarla" (eso seguiría inventando sobre algo ya
      // guardado), es simplemente descartarla.
      match /diagnosticosIA/{diagnosticoId} {
        allow read: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/subjects/$(subjectId)).data.docenteId;
        allow create: if isDocente() &&
          request.auth.uid == get(/databases/$(database)/documents/subjects/$(subjectId)).data.docenteId &&
          request.resource.data.docenteId == request.auth.uid;
        allow update: if false;
        allow delete: if isDocente() &&
          request.auth.uid == get(/databases/$(database)/documents/subjects/$(subjectId)).data.docenteId;
      }

      // Planeación Didáctica Inicial — Asistente IA (FASE 2-BIS, apartado 3).
      // Misma forma exacta que diagnosticosIA: bitácora append-only e
      // inmutable, privada del docente dueño. El .xlsx nunca se guarda aquí
      // (ni en ningún storage) — se arma en el cliente a partir de
      // `resultado` cada vez que el docente descarga (ver
      // src/utils/planeacionExcel.js), así que descargar no cuesta nada
      // aparte ni depende de la red.
      match /planeacionesIA/{planeacionId} {
        allow read: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/subjects/$(subjectId)).data.docenteId;
        allow create: if isDocente() &&
          request.auth.uid == get(/databases/$(database)/documents/subjects/$(subjectId)).data.docenteId &&
          request.resource.data.docenteId == request.auth.uid;
        allow update, delete: if false;
      }

      // Config del Asistente IA de la asignatura (12-ago-2026) — un solo
      // documento con "Comentarios generales del grupo y su entorno": texto
      // libre del docente (p. ej. "apenas saben sumar", "nunca han usado más
      // tecnología que el celular"). A diferencia de diagnosticosIA/
      // planeacionesIA, esto NO es una bitácora — es un campo que el docente
      // edita y vuelve a guardar, como el Perfil IA. Privado del docente
      // dueño: es una observación suya sobre el grupo, no material del curso.
      match /asistenteIA/{docId} {
        allow read: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/subjects/$(subjectId)).data.docenteId;
        allow create, update: if isDocente() &&
          request.auth.uid == get(/databases/$(database)/documents/subjects/$(subjectId)).data.docenteId &&
          request.resource.data.docenteId == request.auth.uid;
        allow delete: if false;
      }
    }

    match /activities/{activityId} {
      allow read: if request.auth != null;
      // Create only within a subject you own, attributed to yourself.
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId &&
        // Crucigrama / Sopa de letras (22-ago-2026): no se puede publicar
        // (oculta:false) un juego cuya cuadrícula no ha sido confirmada por
        // el docente — mismo criterio que 'juego_confirmado' en
        // ContenidoJuegoEditor.jsx/RevisionJuegoBorrador.jsx. Una actividad
        // que YA no es 'juego' (o que ya estaba publicada) no cae aquí.
        // .get(...) con default: una actividad legacy sin `categoria` no
        // debe tronar la regla (comparar contra una propiedad ausente lanza
        // error en Firestore rules, no false) — debe colarse como "no es
        // juego" y seguir el candado normal de las demás categorías.
        // request.method == 'delete' PRIMERO y de corto circuito: en un
        // delete no existe `request.resource` (no hay documento resultante)
        // — referenciar request.resource.data.oculta ahí revienta la regla
        // con un error de evaluación, que el cliente ve como "Missing or
        // insufficient permissions" (encontrado 23-ago-2026 al intentar
        // borrar un borrador de juego sin confirmar). Borrar una actividad
        // propia siempre debe poder hacerse sin importar el estado del
        // candado de publicación.
        (request.method == 'delete' ||
          resource.data.get('categoria', null) != 'juego' ||
          request.resource.data.oculta != false ||
          resource.data.oculta == false ||
          resource.data.juego.estado == 'juego_confirmado');

      // Reactivos de una evaluación. Los lee cualquier cuenta autenticada
      // porque el alumno los necesita para contestar; los escribe solo el
      // docente dueño (se resuelve en la actividad padre).
      //
      // Aquí YA NO vive `respuestaCorrecta`. Vivía, y era el peor agujero que
      // encontró A08: las reglas no pueden filtrar campos, así que la clave
      // viajaba al navegador de cualquiera con sesión —incluido el alumno a
      // punto de contestar—, y ni siquiera hacía falta un cliente modificado
      // porque el runner ya descargaba los documentos enteros. El comentario
      // que había aquí lo admitía: decía que la interfaz era la responsable de
      // no pedir ese campo. Una restricción que solo vive en el navegador no
      // existe (§1.1).
      match /preguntas/{preguntaId} {
        allow read: if request.auth != null;
        allow write: if isDocente() &&
          request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.docenteId;
      }

      // La clave de respuestas, aparte y SOLO para el docente dueño. Es lo que
      // las reglas sí pueden hacer: no filtran campos, pero sí documentos.
      //
      // El alumno nunca lee aquí. Se entera de si acertó por su propia
      // respuesta (`submissions/{id}/respuestas/{pid}`), donde el servidor
      // escribe el veredicto al calificar — y la respuesta correcta solo si el
      // docente publicó las respuestas. Ver `onEvaluacionFinalizada`.
      //
      // La califica el Admin SDK, que no pasa por estas reglas.
      match /clave/{preguntaId} {
        allow read, write: if isDocente() &&
          request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.docenteId;
      }

      // Sugerencias de calificación de C-02 (piloto IA). Las CREA únicamente
      // el servidor (Admin SDK, tras cobrar el crédito): el documento es a la
      // vez el candado de concurrencia por respuesta y la sugerencia
      // persistida. El docente dueño las lee para recuperarlas aunque cierre
      // la pestaña (verlas de nuevo jamás cobra), y las actualiza/borra solo
      // para marcarlas aplicadas o descartarlas. El alumno NUNCA las ve: una
      // calificación sugerida no confirmada no debe llegarle.
      // La lectura NO exige suscripción vigente (ya se pagó con créditos);
      // la escritura sí, como toda escritura de docente.
      match /iaSugerencias/{sugerenciaId} {
        allow read: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.docenteId;
        allow update, delete: if isDocente() &&
          request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.docenteId;
        allow create: if false;
      }

      // Mismo patrón que iaSugerencias, pero UNA por ENTREGA (no por
      // pregunta) — lote "Calificar todas con IA" (OP-11-bis, 21-ago-2026).
      // Las crea únicamente el servidor; el docente dueño las lee y las
      // marca aplicadas/descartadas al revisar cada entrega. El alumno
      // nunca las ve.
      match /iaSugerenciasEntregable/{sugerenciaId} {
        allow read: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.docenteId;
        allow update, delete: if isDocente() &&
          request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.docenteId;
        allow create: if false;
      }

      // Bitácora de OP-10 (análisis de resultados con IA). Un documento NUEVO
      // por cada generación exitosa — el docente los crea desde el cliente
      // (ya pagó el crédito antes de llegar aquí; esto solo persiste la
      // fotografía) vía addDoc, nunca setDoc/update: cada análisis histórico
      // es inmutable, así que no hay update ni delete. Ver los mismos
      // requisitos que iaSugerencias: leer no exige suscripción vigente
      // (consultar la bitácora es gratis), escribir sí.
      match /analisisIA/{analisisId} {
        allow read: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.docenteId;
        allow create: if isDocente() &&
          request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.docenteId &&
          request.resource.data.docenteId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Asistencia — un documento por "hora" de clase (fecha + slot), con un mapa
    // presentes: { alumnoId: bool }. Mismo patrón de propiedad que activities.
    match /attendance/{attendanceId} {
      // Solo docentes/admin: ninguna vista de alumno lee asistencia directamente
      // (cada columna es compartida por TODO el grupo, con motivos de
      // justificación en texto libre) — sin esta restricción cualquier alumno
      // podía listar los pases de lista de toda la plataforma. El alumno ve su
      // propio resumen vía attendanceSummaries (ver más abajo).
      allow read: if isDocente() || isAdmin();
      // Asistencia es GRATUITA (26-ago-2026): no consume créditos y tampoco
      // los exige. Lo único que se comprueba es identidad y propiedad — que
      // seas docente, que el registro sea tuyo y que la asignatura también.
      // El candado anterior por `saldoIAPositivo` se retiró: ver el comentario
      // del modelo de créditos puros arriba.
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Resumen de asistencia POR ALUMNO — lo escribe solo la Cloud Function
    // onAttendanceEscrita (Admin SDK, no pasa por estas reglas), recalculado
    // desde `attendance` cada vez que cambia una columna del grupo. El id del
    // documento ES el mismo id que su enrollment en `students`, así
    // ownsStudentDoc ya resuelve la propiedad sin ayuda adicional. Ningún
    // cliente escribe aquí — de ahí que no haya create/update/delete.
    match /attendanceSummaries/{studentId} {
      allow read: if request.auth != null && ownsStudentDoc(studentId);
    }

    // Personal question bank (Evaluaciones) — strictly owner-only.
    match /bancoReactivos/{reactivoId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Personal rubric bank (Entregables) — strictly owner-only. Students never
    // read this collection: the activity stores its own COPY of the rubric.
    match /bancoRubricas/{rubricaId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Permanent course materials (syllabus, guides, etc.) — not tied to an
    // activity, so they never generate a submission or grade. Same
    // read/write shape as activities: any authenticated user (teacher or
    // enrolled student) can read; only the owning teacher can write/delete.
    match /resources/{resourceId} {
      allow read: if request.auth != null;
      // Only teachers create resources, always attributed to themselves,
      // and only within a subject they own.
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Fuentes del Asistente IA (FASE 2-BIS del Plan Maestro de IA) — PDF/Word
    // que el docente guarda una vez por Asignatura (generales o por parcial)
    // para reutilizarlos como contexto en operaciones de IA futuras. A
    // diferencia de `resources`/`materials`, son PRIVADAS del docente dueño:
    // ni otro docente ni ningún estudiante puede leerlas (piden contexto
    // pedagógico del docente, no material para el grupo). Inmutables: se
    // eliminan y se vuelven a subir, no se editan (así no hay que validar
    // cambios parciales de `ubicacion`/`parcial` en `update`).
    match /fuentesAsignatura/{fuenteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update: if false;
      allow delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Avisos — comunicados de solo-informar del docente a todo el grupo de
    // una asignatura (no es un chat: sin respuestas ni reacciones, así que
    // no hay una sub-colección de mensajes que proteger). Mismo patrón de
    // lectura/escritura que `activities`: cualquier autenticado lee, solo el
    // docente dueño de la asignatura crea/edita/borra los suyos.
    match /avisos/{avisoId} {
      allow read: if request.auth != null;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Confirmación de lectura de un aviso — un doc por (aviso, estudiante),
    // creado únicamente cuando el estudiante toca "Entendido" en la pantalla
    // obligatoria (ver AvisoLecturaModal.jsx). `estudianteId` es el ID del
    // DOC DE INSCRIPCIÓN (mismo patrón que `submissions.alumnoId`), no el
    // auth uid — se resuelve la propiedad con ownsStudentDoc(). Inmutable:
    // ni el estudiante ni el docente pueden editarla o borrarla después,
    // es un registro de auditoría de que sí se mostró y confirmó el aviso.
    match /avisoLecturas/{lecturaId} {
      allow read: if isAdmin() || isDocente() ||
        (request.auth != null && ownsStudentDoc(resource.data.estudianteId));
      allow create: if request.auth != null &&
        ownsStudentDoc(request.resource.data.estudianteId);
      allow update, delete: if false;
    }

    // Guardado personal de un aviso — el "marcador" del alumno, un doc por
    // (aviso, estudiante). A diferencia de `avisos.guardado` (del docente,
    // vive en el propio aviso porque hay un solo dueño), aquí cada alumno
    // necesita su propio estado: uno lo guarda, otro no, sobre el MISMO
    // aviso. Sí se puede borrar (a diferencia de avisoLecturas) — guardar es
    // una preferencia editable, no un registro de auditoría.
    match /avisoGuardados/{guardadoId} {
      allow read, delete: if request.auth != null && ownsStudentDoc(resource.data.estudianteId);
      allow create: if request.auth != null && ownsStudentDoc(request.resource.data.estudianteId);
      allow update: if false;
    }

    // "Eliminar" un aviso del lado del alumno — mismo patrón que
    // avisoGuardados (un doc por aviso, estudiante), pero para ocultarlo en
    // vez de guardarlo: el alumno no puede borrar el aviso real (es del
    // docente, y lo comparten sus compañeros), así que esto solo marca que
    // ya no debe aparecer en SU lista.
    match /avisoOcultos/{ocultoId} {
      allow read, delete: if request.auth != null && ownsStudentDoc(resource.data.estudianteId);
      allow create: if request.auth != null && ownsStudentDoc(request.resource.data.estudianteId);
      allow update: if false;
    }

    // Plantillas de avisos — el banco personal de mensajes rápidos de cada
    // docente (arranca con una copia editable de los 12 predefinidos, ver
    // PLANTILLAS_SEED en src/utils/avisos.js), para elegir de un toque al
    // publicar un aviso. Nadie más las necesita leer: no son parte del aviso
    // ya publicado (ese guarda su propio emoji/título, ver avisoEmoji()),
    // así que a diferencia de `avisos` esto NO es de lectura pública.
    match /avisoPlantillas/{plantillaId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // "Material de apoyo" — per-parcial course material (one or more files +
    // optional rich-text description). Independent of `activities`: it never
    // creates a submission/grade, so it has no link to `submissions` at all.
    // Same read/write shape as resources/activities.
    match /materials/{materialId} {
      allow read: if request.auth != null;
      // Only teachers create materials, always attributed to themselves,
      // and only within a subject they own.
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
    }

    match /submissions/{submissionId} {
      // Un alumno solo lee SUS entregas (calificaciones incluidas) — antes
      // cualquier cuenta autenticada podía listar las de toda la plataforma.
      // Los docentes/admin conservan lectura amplia: sus consultas (por
      // actividad, exports, tablas) no siempre pueden probar propiedad
      // por-documento y el dato sensible protegido aquí es el del alumno.
      // OJO clientes: las consultas de alumno deben filtrar alumnoId con `==`
      // (no `in`) para que ownsStudentDoc sea demostrable dentro del límite
      // de get()s por consulta.
      allow read: if isAdmin() || isDocente() ||
        (request.auth != null && ownsStudentDoc(resource.data.alumnoId));

      // A submission is written either by the student who owns it (submit /
      // resubmit / evaluación autosave) or by the teacher who owns the activity
      // (grading, marking complete). `alumnoId` is the STUDENT ENROLLMENT DOC ID
      // (not the auth uid), so ownership resolves through ownsStudentDoc().
      // El alumno NO escribe su nota: al crear, calificacion debe ser null y
      // estado no puede ser 'calificado'; al actualizar aplica
      // studentNoTocaCalificacion(). La nota real la pone la Cloud Function
      // onEvaluacionFinalizada (Admin SDK) o el docente (ownsActivity).
      //
      // A12 · H5 · R22 — el id NO es libre: tiene que ser
      // `{actividadId}_{alumnoId}`. Antes cada entrega nacía con `addDoc` (id
      // aleatorio), así que nada impedía crear una SEGUNDA submission para la
      // misma pareja — doble clic, dos pestañas, o un reintento de red
      // bastaban. El docente veía una entrega al azar (según el orden, no
      // garantizado, en que Firestore devolvía la consulta) y en una
      // evaluación se saltaba el límite de intentos por completo. Con esto,
      // esa pareja tiene UN SOLO documento posible por construcción: un
      // segundo "create" en el mismo path es, para Firestore, un UPDATE del
      // documento existente — sujeto a studentNoTocaCalificacion() más abajo,
      // no una fila nueva.
      allow create: if request.auth != null &&
        submissionId == request.resource.data.actividadId + '_' + request.resource.data.alumnoId && (
        (
          ownsStudentDoc(request.resource.data.alumnoId) &&
          enrollmentMatchesActivity(request.resource.data.alumnoId, request.resource.data.actividadId) &&
          request.resource.data.get('calificacion', null) == null &&
          request.resource.data.get('estado', '') != 'calificado' &&
          !actividadVencidaParaAlumno(request.resource.data.actividadId, request.resource.data.alumnoId)
        ) ||
        (
          isDocente() &&
          ownsActivity(request.resource.data.actividadId) &&
          calificacionEnRango(request.resource.data.actividadId)
        )
      );
      allow update: if request.auth != null && (
        (
          ownsStudentDoc(resource.data.alumnoId) &&
          studentNoTocaCalificacion() &&
          studentNoManipulaIntento()
        ) ||
        (
          isDocente() &&
          ownsActivity(resource.data.actividadId) &&
          calificacionEnRangoSiCambia(resource.data.actividadId)
        )
      );
      // Borrar una submission borra su nota — eso es manipulación de
      // calificaciones si lo hace el alumno (ningún flujo del alumno borra
      // submissions). Solo el docente dueño de la actividad.
      allow delete: if isDocente() &&
        ownsActivity(resource.data.actividadId);

      // Evaluación answers (autosave + teacher revision). Only the student who
      // owns the parent submission, or the teacher who owns the parent activity,
      // may READ or WRITE — closes the cross-student hole where any
      // authenticated account could see or edit anyone's answers. Reads are
      // always scoped to a concrete submissionId (single doc or subcollection
      // query under it), so the parent get() resolves for list queries too.
      // El alumno solo autoguarda su respuesta — puntosObtenidos lo escriben
      // únicamente el servidor (Admin SDK) y el docente: sin este candado, un
      // cliente modificado podía asignarse los puntos de las preguntas de
      // revisión manual antes de que el docente las revisara.
      match /respuestas/{preguntaId} {
        allow read: if request.auth != null && (
          (
            exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
            ownsStudentDoc(get(/databases/$(database)/documents/submissions/$(submissionId)).data.alumnoId)
          ) || (
            exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
            ownsActivity(get(/databases/$(database)/documents/submissions/$(submissionId)).data.actividadId)
          )
        );
        allow write: if request.auth != null && (
          (
            isDocente() &&
            exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
            ownsActivity(get(/databases/$(database)/documents/submissions/$(submissionId)).data.actividadId)
          ) || (
            exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
            ownsStudentDoc(get(/databases/$(database)/documents/submissions/$(submissionId)).data.alumnoId) &&
            (
              resource == null
                ? !request.resource.data.keys().hasAny(['puntosObtenidos'])
                : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['puntosObtenidos'])
            ) &&
            // El tiempo se acabó de verdad, no según el reloj del teléfono.
            dentroDelPlazo(submissionId)
          )
        );
      }

      // Capa 2 de OP-10 — fotografía inmutable de las respuestas de un
      // intento (ver functions/index.js, onEvaluacionFinalizada). A
      // diferencia de `respuestas`, aquí NUNCA lee el alumno (no es una
      // pantalla de revisión, es un insumo interno de análisis) y NADIE
      // escribe desde el cliente — ni el propio docente: solo el Admin SDK,
      // que no pasa por estas reglas. `allow write: if false` es la
      // protección que sí puede hacer cumplir el cliente; que además `tx.create`
      // (no `tx.set`) en el servidor rechace sobrescribir un snapshot
      // existente es la protección de inmutabilidad real (ver el comentario
      // en onEvaluacionFinalizada).
      match /intentosRespuestas/{numeroIntento} {
        allow read: if request.auth != null &&
          exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
          ownsActivity(get(/databases/$(database)/documents/submissions/$(submissionId)).data.actividadId);
        allow write: if false;
      }
    }

    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if request.auth != null && (
        isAdmin() || resource.data.docenteId == request.auth.uid
      );
      // NADIE crea suscripciones desde el cliente, solo el administrador.
      //
      // Antes el docente podía crear la suya "en prueba o pendiente de pago", y
      // por ahí se colaban DOS ataques con una línea desde la consola del
      // navegador:
      //   · Crear una con `planId` y una `fechaVencimiento` a diez años: la
      //     Cloud Function que espeja la vigencia la tomaba por buena y le
      //     abría el candado de escritura (y le quitaba la marca de agua).
      //   · Crear una prueba nueva cada vez que la anterior venciera —
      //     `updatedAt` más reciente gana— para siempre.
      // La prueba inicial ahora la crea el servidor (onDocenteCreado en
      // functions/index.js), con sus propias fechas, que nadie puede inventar.
      allow create: if isAdmin();

      // El docente solo puede DECLARAR que va a pagar. `hasOnly` congela todo
      // lo demás: sin esto podía reescribir fechas y plan en el mismo update
      // que cambiaba el status, que era el agujero de verdad — el status por sí
      // solo no otorga nada, las fechas sí.
      allow update: if isAdmin() || (
        isDocente() &&
        resource.data.docenteId == request.auth.uid &&
        request.resource.data.status == 'pendiente_pago' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'escuelaId', 'schoolName'])
      );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null && (
        isAdmin() || resource.data.docenteId == request.auth.uid
      );
      // Un docente DECLARA una transferencia; el administrador la coteja con el
      // estado de cuenta y la aprueba. Aprobar es lo único que activa la
      // suscripción, y eso ya era exclusivo del admin (`update`).
      //
      // Lo que faltaba candar es CUÁNTO se activa. Al aprobar, el panel lee del
      // propio pago la periodicidad del plan y los meses (ver handleApprove en
      // PaymentsTable.jsx), así que un pago fabricado desde la consola con
      //   { planId: 'anual', mesesPagados: 6 }
      // convertía una transferencia de un mes en SEIS AÑOS de suscripción, sin
      // que el diálogo de confirmación dijera nada de años. Por eso el plan y
      // los meses se fijan aquí:
      //   · planId + mesesPagados + monto — desde el Bloque 7 (13-ago-2026)
      //     los tres se validan juntos vía `montoOficialPago`: solo 'pro'
      //     (1 a 6 meses, tabla de descuento) y 'mayor' (únicamente 1 mes,
      //     $199, sin descuento) tienen tarifa oficial. Cualquier otro
      //     planId, o una combinación de meses que no exista en la tabla
      //     (p. ej. 'mayor' a 2 meses, o 'pro' a 7), no tiene tarifa y la
      //     comparación de monto falla sola — no hace falta un chequeo de
      //     rango de meses aparte. Si algún día vuelve el anual, se agrega
      //     aquí a propósito.
      //   · subscriptionId tiene que ser SUYA: sin esto, un docente podía pagar
      //     y acreditarle el mes a la cuenta de otro.
      //   · createdAt == request.time — el folio de transacción del panel se
      //     numera por antigüedad; con una fecha inventada un pago nuevo podía
      //     colarse como si fuera viejo.
      //   · hasOnly cierra el resto: `archivado` (un pago nacía escondido de la
      //     lista del admin), `comentarios`, `notasAdmin` (notas del admin que
      //     el docente no escribe) y `notificadoAdmin` (el candado de
      //     idempotencia del aviso — ponerlo en true silenciaba el push).
      // El MONTO SÍ se valida contra la tarifa oficial (Bloque 7,
      // 13-ago-2026 — antes NO se validaba a propósito porque la tarifa de
      // lanzamiento cambiaba seguido; ahora el modelo comercial ya es
      // definitivo, así que dejar de validarlo era el hueco real: un
      // docente podía declarar 'mayor' a $1 y solo la revisión manual del
      // admin lo detenía). `montoOficialPago` es la única fuente — si la
      // combinación planId/meses no tiene tarifa, regresa null y
      // `monto == null` nunca es cierto para un número, así que la
      // combinación se rechaza sola sin necesitar un chequeo aparte.
      // `hasAll`/`hasOnly` van PRIMERO: leer un campo que no existe no da
      // falso, revienta la evaluación entera de la regla. Con el juego de
      // llaves ya comprobado, todo lo de abajo se puede leer sin rodeos.
      allow create: if isAdmin() || (
        isDocente() &&
        request.resource.data.keys().hasAll([
          'docenteId', 'subscriptionId', 'planId', 'monto', 'metodo', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'docenteId', 'subscriptionId', 'planId', 'escuelaId', 'monto', 'mesesPagados',
          'metodo', 'referencia', 'status', 'createdAt', 'comprobanteUrl', 'reenvioDePagoId'
        ]) &&
        request.resource.data.docenteId == request.auth.uid &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.metodo == 'transferencia' &&
        // `mesesPagados` se valida pero NO se exige: la app de Android lleva su
        // propio paquete y tarda en actualizarse, y un pago sin el campo vale
        // por un mes en todo el proyecto (`mesesPagados || 1` al aprobar). Sin
        // este default, la app instalada hoy se quedaría sin poder reenviar un
        // pago rechazado en cuanto se publiquen estas reglas.
        request.resource.data.get('mesesPagados', 1) is int &&
        request.resource.data.monto == montoOficialPago(request.resource.data.planId, request.resource.data.get('mesesPagados', 1)) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.subscriptionId is string &&
        exists(/databases/$(database)/documents/subscriptions/$(request.resource.data.subscriptionId)) &&
        get(/databases/$(database)/documents/subscriptions/$(request.resource.data.subscriptionId)).data.docenteId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ── Compra de créditos adicionales (18-ago-2026) ────────────────────────
    // Mismo patrón que `payments`: hoy la única vía real es transferencia +
    // aprobación manual del admin. La acreditación del saldo NUNCA pasa por
    // aquí — `iaCreditos` es allow write: if false para todo cliente, así que
    // aprobar una compra siempre pasa por la Cloud Function
    // `aprobarCompraCreditos` (functions/index.js →
    // creditosLedger.acreditarCompraCreditos), que relee este doc dentro de
    // una transacción y es idempotente por diseño.
    match /creditPurchases/{purchaseId} {
      allow read: if isAdmin() || (
        request.auth != null && request.auth.uid == resource.data.docenteId
      );
      allow create: if isDocente() &&
        request.resource.data.keys().hasAll([
          'docenteId', 'creditos', 'montoMXN', 'metodo', 'status', 'origen', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'docenteId', 'creditos', 'montoMXN', 'metodo', 'referencia', 'status', 'origen',
          'createdAt', 'comprobanteUrl'
        ]) &&
        request.resource.data.docenteId == request.auth.uid &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.metodo == 'transferencia' &&
        request.resource.data.origen == 'creditos_adicionales' &&
        request.resource.data.montoMXN == montoOficialCredito(request.resource.data.creditos) &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // App configuration: IA rates, payment settings, etc.
    // Only authenticated users read this; secrets never land here (those live in
    // server env vars), but payment config (CLABE) warrants authentication anyway.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Personal calendar events created by the teacher — 100% privados, nunca
    // visibles a alumnos.
    match /events/{eventId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Eventos ACADÉMICOS del docente (conferencias, suspensiones, entregas de
    // proyecto…) — compartidos con los alumnos de `asignaturaId`. Colección
    // SEPARADA de `events` a propósito: Firestore solo puede autorizar un
    // `list` cuando la regla se puede probar a partir de los propios filtros
    // de la consulta. El alumno consulta por `asignaturaId` (no conoce el
    // docenteId de antemano), así que una regla que dependiera de
    // `resource.data.docenteId`/`tipo` (como en `events`) rechaza la
    // consulta ENTERA aunque cada documento sí cumpliera la condición —
    // comprobado en vivo: `getDoc` de un documento así sí funciona, pero el
    // `list` por `asignaturaId` da "Missing or insufficient permissions".
    // Lectura amplia (mismo patrón que activities/avisos/materials): no es
    // información sensible, el alumno filtra del lado cliente sus materias.
    match /academicEvents/{eventId} {
      allow read: if request.auth != null;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId &&
        ownsSubject(request.resource.data.asignaturaId);
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Personal calendar events created by a STUDENT (their own Agenda) —
    // mismo patrón que `events` del docente, pero con alumnoId (uid de Auth).
    match /studentEvents/{eventId} {
      allow read, update, delete: if request.auth != null &&
        request.auth.uid == resource.data.alumnoId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.alumnoId;
    }

    // Teacher's class schedule blocks (Mi Horario — legacy recurring blocks).
    match /horario/{bloqueId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Programación de bloques de clases por asignatura (fechas reales generadas
    // a partir de un rango + patrones semanales; se pueden mover/editar/eliminar
    // individualmente). Lectura ampliada a cualquier autenticado — igual que
    // activities/avisos/materials — para que la Agenda del alumno pueda armar
    // "Ahora"/"Próxima clase" a partir del horario de sus propios docentes;
    // no es información sensible (materia, hora, aula), y el alumno filtra
    // del lado cliente solo lo de sus materias inscritas.
    match /horarioBloques/{bloqueId} {
      allow read: if request.auth != null;
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Días de asueto del docente. Cada doc marca una fecha en la que no se
    // permiten (según su alcance) clases, eventos y/o actividades.
    match /asuetos/{asuetoId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Chat con Asistente (17-ago-2026) — un documento por MENSAJE (docente o
    // asistente), de una asignatura (subjectId) o del Asistente General
    // (subjectId ausente/null). Persiste hasta que el docente lo borre —
    // "el docente debe poder ver hacia atrás", pedido explícito — nunca se
    // borra solo, ni al cambiar de asignatura ni al recargar.
    match /chatMensajes/{mensajeId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId;
      // Borrar (limpiar la conversación) es lo único que el docente hace
      // aquí después de crear un mensaje — nunca lo edita. Marcar una
      // propuesta como `ejecutada` (Chat con Acciones) lo hace el SERVIDOR
      // con el Admin SDK, dentro de la misma operación de crédito que crea
      // la actividad/examen (18-ago-2026) — el cliente ya no necesita ni
      // puede escribir ese campo, así que no hace falta ninguna excepción
      // aquí.
      allow update: if false;
      // Faltaba esta regla (bug real, 18-ago-2026): el comentario de arriba
      // ya describía borrar como la acción del docente, pero sin `allow
      // delete` Firestore lo negaba por omisión — "Missing or insufficient
      // permissions" cada vez que intentaba limpiar una conversación.
      allow delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
    }

    // Chat de Administración (19-ago-2026) — mismo patrón que chatMensajes,
    // pero con `adminUid` en vez de `docenteId`, exclusivo del rol admin, y
    // SIN candado de suscripción (isDocente() no aplica a un admin).
    match /adminChatMensajes/{mensajeId} {
      allow read: if isAdmin() && request.auth.uid == resource.data.adminUid;
      allow create: if isAdmin() && request.auth.uid == request.resource.data.adminUid;
      allow update: if false;
      allow delete: if isAdmin() && request.auth.uid == resource.data.adminUid;
    }

    // Métricas internas del Chat de Administración (tokens, modelo,
    // stopReason) — mismo criterio que iaConsumosInterno: nada visible para
    // ningún cliente, solo lo escribe el servidor con el Admin SDK.
    match /adminChatConsumosInterno/{consumoId} {
      allow read, write: if false;
    }

    // Vacaciones del docente. Cada doc marca un PERIODO (fechaInicio–fechaFin)
    // en el que no se permiten (según su alcance) clases, eventos y/o
    // actividades — misma estructura que asuetos, pero para un rango de días.
    match /vacaciones/{vacacionId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.docenteId;
      allow update, delete: if isDocente() &&
        request.auth.uid == resource.data.docenteId;
      allow create: if isDocente() &&
        request.auth.uid == request.resource.data.docenteId;
    }

    // Preferencias de notificación del estudiante — UNA por cuenta (el id del
    // doc ES su uid de Auth, global entre todas sus inscripciones). Solo el
    // propio estudiante la lee/escribe; Cloud Functions usa el Admin SDK y
    // no pasa por estas reglas.
    // Constancia de baja de un docente: nombre, correo y fecha, nada más. La
    // escribe api/account/delete.js con el Admin SDK (por eso no hay `write`)
    // para que el panel pueda mostrar "Cuenta eliminada" en vez de que el
    // renglón desaparezca sin dejar rastro.
    //
    // No tenía regla, así que Firestore la denegaba por omisión: el panel la
    // lee con un .catch que se tragaba el error, y la constancia se escribía
    // sin que NADIE pudiera leerla jamás. Todo el trabajo de dejar rastro no
    // servía de nada, y en silencio.
    match /bajas/{docenteId} {
      allow read: if isAdmin();
      // El admin puede borrar la CONSTANCIA (no es el docente ni su
      // suscripción, que ya no existen) — pedido explícito 19-ago-2026 tras
      // encontrar registros duplicados que el panel no dejaba limpiar.
      allow delete: if isAdmin();
    }

    match /notificationSettings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Registro de notificaciones REALMENTE enviadas (docente o alumno) —
    // la Cloud Function las escribe vía Admin SDK (bypasa estas reglas); el
    // cliente lee, crea (recordatorios locales, ver más abajo) y borra solo
    // las suyas — la Bitácora de Notificaciones (docente) permite borrar
    // cada renglón. `uid` es el destinatario, NO el id del documento (ids
    // autogenerados: puede haber muchas por uid).
    match /notificationLog/{logId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      // El docente registra sus propios recordatorios locales (clase/evento)
      // entregados en su celular — los push del servidor los sigue
      // registrando la Cloud Function (Admin SDK, no pasa por esta regla).
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // ── Créditos IA ─────────────────────────────────────────────────────────
    // Evalúa Fácil (el servidor) es la ÚNICA fuente de verdad del saldo: todo
    // se escribe con Admin SDK desde Cloud Functions, que bypasa estas reglas.
    // El cliente solo LEE lo suyo (la barra y el panel viven de eso). Sin
    // escrituras de cliente no existe camino para manipular el saldo.
    match /iaCreditos/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    // Historial de consumos (alimenta el detalle del panel). Cada quien lee
    // los suyos. Sin tokens ni costos monetarios: el docente piensa en
    // créditos — lo interno vive en iaConsumosInterno.
    match /iaConsumos/{consumoId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Métricas internas (tokens, modelo, tiempos) y registro de medición del
    // trial: nada de esto es visible para ningún cliente.
    match /iaConsumosInterno/{consumoId} {
      allow read, write: if false;
    }
    // Bienvenida voluntaria de créditos (20-ago-2026): el docente necesita
    // LEER su propio estado (bienvenidaDisponible/bienvenidaActivada) para
    // que el frontend sepa si mostrar el CTA de activación — pero la
    // acreditación en sí sigue siendo exclusivamente server-side
    // (activarCreditosBienvenida en functions/index.js), nunca un write
    // directo del cliente.
    //
    // El admin también lee (2-sep-2026), mismo patrón que `iaCreditos` aquí
    // arriba: sin esto, el histórico del panel solo puede enseñar un saldo
    // suelto, y un "0" ahí no distingue a quien nunca activó su regalo de
    // quien ya lo gastó — dos situaciones que para administración no son la
    // misma. La escritura sigue cerrada para TODOS, admin incluido.
    match /iaTrialRegistro/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    // ── Enlaces de descarga del APK de Android ──
    // El ID del doc ES el slug del enlace (ver src/utils/descargaLinks.js).
    //
    // Lectura pública a propósito: quien abre /descarga/{slug} no está
    // autenticado, así que la página no podría resolver el enlace de otro
    // modo. Lo que protege el enlace es que el slug sea impredecible (10
    // caracteres aleatorios), no la regla — igual que un enlace "no listado"
    // de YouTube. No guardes nada sensible en estos docs.
    //
    // Escritura solo para admin: crear, activar/desactivar y borrar enlaces
    // se hace desde el panel (pestaña Descargas).
    match /downloadLinks/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
